# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/safetrail
MONGO_URI=mongodb://localhost:27017/safetrail
REDIS_URL=redis://localhost:6379

# ─── Twilio ─────────────────────────────────────────────
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_FROM=+1234567890
EMERGENCY_CONTACT_NUMBER=+911234567890

# ─── Firebase (FCM) ─────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
CITY_CODE=MUM

# ─── Blockchain ──────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=0xyour_wallet_private_key
CONTRACT_ADDRESS=0x_deployed_contract_address

# ─── AI Services ─────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key

# ─── Maps ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ─── Mock External APIs ──────────────────────────────────
POLICE_API_URL=http://localhost:9001
HOSPITAL_API_URL=http://localhost:9002

# ─── App ─────────────────────────────────────────────────
SECRET_KEY=your_jwt_secret_key_min_32_chars
ENVIRONMENT=development
